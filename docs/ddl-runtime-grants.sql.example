-- Replace <strong-generated-password> before running with admin credentials.
-- Review the application schema name if it is not globalcomix.
CREATE USER 'cdc_stream'@'%' IDENTIFIED BY '<strong-generated-password>' REQUIRE SSL;

GRANT SELECT, INSERT, UPDATE, DELETE
    ON globalcomix.*
    TO 'cdc_stream'@'%';

GRANT SELECT, INSERT, UPDATE
    ON cdc.stream_checkpoint
    TO 'cdc_stream'@'%';

GRANT SELECT, INSERT
    ON cdc.ddl_events
    TO 'cdc_stream'@'%';

GRANT EXECUTE
    ON PROCEDURE cdc.ddl_events_trigger_inventory
    TO 'cdc_stream'@'%';

-- This exact EXECUTE grant is the runtime's only trigger-inventory access. The
-- account intentionally lacks TRIGGER and must not query
-- information_schema.triggers directly. The procedure must remain a
-- SQL SECURITY DEFINER routine named <table>_trigger_inventory.
-- Expected global grant is USAGE only. Do not grant roles, PROXY, ALL,
-- ROLE_ADMIN, UPDATE/DELETE/ALTER/DROP/TRIGGER on cdc.ddl_events, or schema-wide
-- cdc privileges. For a custom schema.table ledger, grant EXECUTE on the
-- corresponding <table>_trigger_inventory procedure in that schema.
SHOW GRANTS FOR 'cdc_stream'@'%';
