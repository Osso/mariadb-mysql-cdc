-- Run with admin/resolver credentials. Replace the password and review the
-- application schema before use. Runtime validation is fail-closed; it never
-- creates or repairs control-plane objects. Existing accounts provisioned by
-- the legacy contract must first apply
-- docs/live-stream-runtime-grants-migration-20260818.sql.
CREATE USER 'cdc_stream'@'%' IDENTIFIED BY '<strong-generated-password>' REQUIRE SSL;

-- Application-schema DDL grant used by the reviewed automatic replay contract.
GRANT
    SELECT,
    INSERT,
    UPDATE,
    DELETE,
    CREATE,
    ALTER,
    DROP,
    INDEX,
    REFERENCES,
    CREATE VIEW,
    SHOW VIEW,
    CREATE ROUTINE,
    ALTER ROUTINE,
    EXECUTE,
    EVENT,
    TRIGGER
    ON globalcomix.*
    TO 'cdc_stream'@'%';

GRANT SELECT, INSERT, UPDATE
    ON cdc.stream_checkpoint
    TO 'cdc_stream'@'%';

GRANT SELECT, INSERT, UPDATE
    ON cdc.ddl_replay_journal
    TO 'cdc_stream'@'%';

-- Required at stream startup. Apply docs/stream-recovery-records-bootstrap.sql
-- before starting the stream; missing table, triggers, procedure, or grants fail
-- startup. No compatibility fallback exists.
GRANT SELECT, INSERT, UPDATE
    ON cdc.stream_recovery_records
    TO 'cdc_stream'@'%';

-- Required only when this account runs staged sync or lost-binlog recovery.
-- Bootstrap the table first with docs/sync-phase-progress-bootstrap.sql.
-- This exact table grant covers phase reads/writes. Current phased runtime also
-- issues CREATE TABLE IF NOT EXISTS, which requires separately reviewed existing
-- CREATE ON cdc.* access; do not add that broad grant to this stream example.
GRANT SELECT, INSERT, UPDATE
    ON cdc.sync_runs_phases
    TO 'cdc_stream'@'%';

GRANT EXECUTE
    ON PROCEDURE cdc.ddl_replay_journal_trigger_inventory
    TO 'cdc_stream'@'%';

GRANT EXECUTE
    ON PROCEDURE cdc.stream_recovery_records_trigger_inventory
    TO 'cdc_stream'@'%';

-- Historical cdc.row_conflicts objects belong to the independent evidence
-- workflow. Do not grant that table or its inventory procedure to cdc_stream.
--
-- Effective-grant acceptance contract. This is bootstrap/startup state and is
-- validated once before source replication; event handling does not rerun SHOW
-- GRANTS or a second grant-policy allowlist for each generated statement.
-- * global scope: USAGE only;
-- * exact checkpoint SELECT/INSERT/UPDATE;
-- * exact journal, recovery-record, and staged phase-progress SELECT/INSERT/UPDATE;
-- * EXECUTE only on the DDL-journal and recovery-record trigger-inventory procedures;
-- * no GRANT OPTION, PROXY, roles, ALL, global mutation, schema-wide cdc
--   mutation/object creation or conflict-ledger access. Staged phase progress is
--   restricted to cdc.sync_runs_phases only; any separate recovery CREATE grant
--   remains outside this stream-only example.
--
-- Startup calls the exact definer-safe DDL-journal and recovery-record procedures
-- and validates their returned trigger rows. Event handling executes known internal operations
-- directly and surfaces database errors; it does not rerun grant validation.
-- Admin/resolver credentials independently review SHOW CREATE PROCEDURE and
-- actual trigger rows; runtime does not require routine metadata privileges or
-- a SHOW CREATE query.
SHOW GRANTS FOR 'cdc_stream'@'%';
